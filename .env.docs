# 공개 문서 인스턴스(docs) 빌드 변수 — `pnpm build --mode docs --outDir dist-docs`
#
# 팀 위키(/wiki/)와 같은 코드베이스에서 만드는 두 번째 산출물이다. 비밀값은 없다(전부 경로/플래그).
# 설계: docs/superpowers/specs/2026-09-04-public-docs-instance-design.md §2.2

# nginx가 /docs/ 아래에 올린다. BrowserRouter basename은 이 값에서 파생한다(main.tsx).
VITE_BASE=/docs/

# 웹 UI의 모든 쓰기 어포던스를 숨기고 로그인 게이트를 끈다.
VITE_WIKI_READONLY=true

# nginx가 /api/docs/ 를 docs 백엔드로 직접 프록시한다(게이트웨이를 거치지 않는다).
VITE_WIKI_API_PREFIX=/api/docs
VITE_SEARCH_API_PREFIX=/api/docs/search
